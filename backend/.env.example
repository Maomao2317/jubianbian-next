# Optional paths
# JBB_DATA_DIR=./data
# JBB_ENVIRONMENT=development
# JBB_COOKIE_SECURE=0
# JBB_MAX_UPLOAD_MB=500
# JBB_MAX_DURATION_MINUTES=6
# JBB_WORKER_CONCURRENCY=16
# JBB_ARK_MAX_IN_FLIGHT=16
# JBB_EVIDENCE_CONCURRENCY=2
# JBB_RESOURCE_DIR=./data/runtime-limits
# JBB_SHARED_MODEL_CONCURRENCY=16
# JBB_DOWNLOAD_CONCURRENCY=2
# JBB_LOCAL_ASR_CONCURRENCY=1
# JBB_LOCAL_ASR_CPU_THREADS=4
# JBB_OCR_PROCESS_CONCURRENCY=4
# JBB_ARK_QUOTA_SCOPE=shared-account
# JBB_ARK_QUOTA_RPM=0
# JBB_ARK_QUOTA_TPM=0
# JBB_ARK_INPUT_TOKEN_RESERVE=65536
# Optional AI generation. Leave unset to use the local fallback script.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TEXT_MODEL=gpt-4o-mini

# Email verification (Tencent Cloud SES transactional email API)
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-guangzhou
# TENCENTCLOUD_SES_ENDPOINT=ses.tencentcloudapi.com
# TENCENTCLOUD_SES_FROM_EMAIL=
# TENCENTCLOUD_SES_FROM_NAME=剧编编
# TENCENTCLOUD_SES_TEMPLATE_ID=0
# JBB_AUTH_ALLOW_DEV_CODE=1
