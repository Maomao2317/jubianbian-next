# Optional paths
# JBB_DATA_DIR=./data
# JBB_MAX_UPLOAD_MB=500
# JBB_MAX_DURATION_MINUTES=6
# Optional AI generation. Leave unset to use the local fallback script.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_TEXT_MODEL=gpt-4o-mini

# Email verification (Tencent Cloud SES transactional email API)
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-guangzhou
# TENCENTCLOUD_SES_ENDPOINT=ses.tencentcloudapi.com
# TENCENTCLOUD_SES_FROM_EMAIL=
# TENCENTCLOUD_SES_FROM_NAME=剧编编
# JBB_AUTH_ALLOW_DEV_CODE=1
