# Production and staging use separate hostnames and separate application
# containers. Caddy obtains and renews HTTPS certificates automatically after
# the DNS A records point at this server.
jubianbian.com, www.jubianbian.com {
    encode gzip
    request_body {
        max_size 500MB
    }
    reverse_proxy app:8000
}

test.jubianbian.com {
    encode gzip
    request_body {
        max_size 500MB
    }
    reverse_proxy host.docker.internal:18000
}
