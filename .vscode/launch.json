{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jubianbian backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",
      "args": [
        "app.main:app",
        "--app-dir",
        "${workspaceFolder}/backend",
        "--reload",
        "--port",
        "8000"
      ],
      "envFile": "${workspaceFolder}/fangzhou.env",
      "jinja": true
    }
  ]
}
