# Copy to .env before `docker compose up -d` when AI recognition is needed.
OPENAI_API_KEY=
JBB_ENVIRONMENT=production
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini
# Independent local evidence. The small model is cached in the persistent data volume.
JBB_LOCAL_ASR_MODEL=small
JBB_LOCAL_ASR_DEVICE=cpu
JBB_LOCAL_ASR_COMPUTE_TYPE=int8
JBB_LOCAL_ASR_LANGUAGE=zh
JBB_LOCAL_ASR_BEAM_SIZE=5
JBB_LOCAL_ASR_VAD_MIN_SPEECH_MS=100
JBB_LOCAL_ASR_VAD_MIN_SILENCE_MS=300
JBB_LOCAL_ASR_VAD_SPEECH_PAD_MS=200
JBB_OCR_LANG=chi_sim+eng
JBB_OCR_SAMPLE_INTERVAL_SECONDS=0.25
JBB_OCR_MAX_FRAMES=720
JBB_MAX_UPLOAD_MB=500
JBB_MAX_DURATION_MINUTES=6
JBB_WORKER_CONCURRENCY=8
JBB_ARK_MAX_IN_FLIGHT=4
JBB_ARK_UPLOAD_MAX_IN_FLIGHT=2
JBB_ARK_PROXY_MAX_IN_FLIGHT=1
JBB_EVIDENCE_CONCURRENCY=2
JBB_UPLOAD_RESERVATION_TTL_SECONDS=7200
JBB_RATE_LIMIT_API_PER_MINUTE=120
JBB_RATE_LIMIT_CREATE_PER_WINDOW=10
JBB_RATE_LIMIT_CREATE_WINDOW_SECONDS=600
JBB_TRUST_PROXY_HEADERS=1
JBB_COOKIE_SECURE=1
JBB_RETENTION_DAYS=30
JBB_LOG_LEVEL=INFO
JBB_LOG_MAX_BYTES=5242880
JBB_LOG_BACKUP_COUNT=5

# Ark (Volcengine) video understanding. Keep the real key in fangzhou.env.
ARK_API_KEY=
ARK_API_KEY_2=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-turbo-260628
ARK_LITE_MODEL=doubao-seed-2-0-lite-260428
ARK_TURBO_MODEL=doubao-seed-2-1-turbo-260628
ARK_ROUTING_MODE=complexity
ARK_VIDEO_FPS=1.0
ARK_UPLOAD_TIMEOUT_SECONDS=120
ARK_UPLOAD_ATTEMPTS=2
# Combined Files upload budget, including attempts/backoff. Exhaustion stops whole-task retries.
ARK_UPLOAD_TOTAL_TIMEOUT_SECONDS=240
# MiB: skip compression below the trigger; aim below the target for large sources.
ARK_UPLOAD_PROXY_TRIGGER_MB=45
ARK_UPLOAD_PROXY_MAX_MB=40
# Long edge, preserving landscape/portrait aspect ratio without upscaling.
ARK_UPLOAD_PROXY_MAX_HEIGHT=1280
ARK_UPLOAD_PROXY_VIDEO_BITRATE=2500k
ARK_UPLOAD_PROXY_AUDIO_BITRATE=96k
ARK_UPLOAD_PROXY_PRESET=veryfast
ARK_UPLOAD_PROXY_TIMEOUT_SECONDS=300
ARK_UPLOAD_PROXY_THREADS=2
ARK_RESPONSE_TIMEOUT_SECONDS=420
ARK_RESPONSE_POLL_SECONDS=5
ARK_RESPONSE_POLL_TIMEOUT_SECONDS=900
ARK_RESPONSE_CREATE_ATTEMPTS=2
ARK_THINKING_TYPE=disabled
# 方舟达到限流/额度上限时，自动尝试 OpenAI；备用识别也失败时任务重试/失败，不生成伪剧本。
ARK_FALLBACK_ON_ERROR=1

# Optional S3-compatible direct upload (AWS S3, R2, COS/OBS S3 gateways, MinIO).
# Leave empty to use four-way concurrent uploads to the app's local volume.
JBB_OBJECT_STORAGE_ENDPOINT=
JBB_OBJECT_STORAGE_BUCKET=
JBB_OBJECT_STORAGE_REGION=auto
JBB_OBJECT_STORAGE_ACCESS_KEY=
JBB_OBJECT_STORAGE_SECRET_KEY=
JBB_OBJECT_STORAGE_ADDRESSING_STYLE=path
JBB_OBJECT_STORAGE_PRESIGN_SECONDS=3600
JBB_OBJECT_STORAGE_PREFIX=jubianbian/uploads

# Email verification (Tencent Cloud SES transactional email API)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_SES_ENDPOINT=ses.tencentcloudapi.com
TENCENTCLOUD_SES_FROM_EMAIL=
TENCENTCLOUD_SES_FROM_NAME=剧编编
TENCENTCLOUD_SES_TEMPLATE_ID=0
# Use 1 only for local development without SES; keep 0 on staging and production.
JBB_AUTH_ALLOW_DEV_CODE=0
JBB_AUTH_CODE_RESEND_SECONDS=60
JBB_AUTH_CODE_MAX_ATTEMPTS=5
