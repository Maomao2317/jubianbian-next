# Copy to .env before `docker compose up -d` when AI recognition is needed.
OPENAI_API_KEY=
JBB_ENVIRONMENT=production
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_TEXT_MODEL=gpt-4o-mini
JBB_MAX_UPLOAD_MB=500
JBB_MAX_DURATION_MINUTES=6
JBB_RATE_LIMIT_API_PER_MINUTE=120
JBB_RATE_LIMIT_CREATE_PER_WINDOW=10
JBB_RATE_LIMIT_CREATE_WINDOW_SECONDS=600
JBB_TRUST_PROXY_HEADERS=1
JBB_COOKIE_SECURE=1
JBB_RETENTION_DAYS=30
JBB_LOG_LEVEL=INFO
JBB_LOG_MAX_BYTES=5242880
JBB_LOG_BACKUP_COUNT=5

# Ark (Volcengine) video understanding. Keep the real key in fangzhou.env.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-turbo-260628
ARK_LITE_MODEL=doubao-seed-2-1-lite-260915
ARK_TURBO_MODEL=doubao-seed-2-1-turbo-260628
ARK_ROUTING_MODE=complexity
ARK_VIDEO_FPS=0.5
# 方舟达到限流/额度上限时，自动尝试 OpenAI；备用识别也失败时任务重试/失败，不生成伪剧本。
ARK_FALLBACK_ON_ERROR=1

# Email verification (Tencent Cloud SES transactional email API)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_SES_ENDPOINT=ses.tencentcloudapi.com
TENCENTCLOUD_SES_FROM_EMAIL=
TENCENTCLOUD_SES_FROM_NAME=剧编编
TENCENTCLOUD_SES_TEMPLATE_ID=0
# Use 1 only for local development without SES; keep 0 on staging and production.
JBB_AUTH_ALLOW_DEV_CODE=0
JBB_AUTH_CODE_RESEND_SECONDS=60
JBB_AUTH_CODE_MAX_ATTEMPTS=5
